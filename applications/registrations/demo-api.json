{
  "name": "demo-api",
  "owner": "platform-team",
  "environment": "dev",
  "namespace": "demo",
  "image": "replace-with-your-acr.azurecr.io/demo-api:0.1.0",
  "resourceProfile": "small",
  "healthCheckPath": "/health",
